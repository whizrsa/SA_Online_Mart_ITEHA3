@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container min-vh-100 d-flex justify-content-center align-items-center mt-2">
    <div class="card shadow-lg border-0 rounded" style="width: 450px; background-color: #ffffff;">
        <div class="card-body p-4">
            <h3 class="text-center text-dark mb-3">Create an Account</h3>
            <hr class="mb-4">

            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <!-- First Name -->
                <div class="mb-3">
                    <label class="form-label fw-bold">First Name</label>
                    <input asp-for="Input.FirstName" class="form-control" placeholder="Enter your first name">
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>

                <!-- Last Name -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Last Name</label>
                    <input asp-for="Input.LastName" class="form-control" placeholder="Enter your last name">
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Email Address</label>
                    <input asp-for="Input.Email" class="form-control" placeholder="Enter your email">
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Phone Number -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Phone Number</label>
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Enter your phone number">
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>

                <!-- Address -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Address</label>
                    <input asp-for="Input.Address" class="form-control" placeholder="Enter your address">
                    <span asp-validation-for="Input.Address" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Password</label>
                    <input asp-for="Input.Password" type="password" class="form-control" placeholder="Enter your password">
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <!-- Confirm Password -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Confirm your password">
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- Buttons -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn text-white fw-bold" style="background-color: #2C033A;">Register</button>
                    <a class="btn btn-outline-secondary" href="/" role="button">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
