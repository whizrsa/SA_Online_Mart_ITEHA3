@model Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-5 p-4 shadow-lg bg-white rounded">
    <div class="row pb-3 text-center">
        <h2 class="fw-bold text-dark">✏️Edit Category</h2>
    </div>

    <form method="post" asp-action="Edit">
        <div class="form-row">
            <div class="form-floating mb-3">
                <input type="text" class="form-control" asp-for="CategoryId" placeholder="Enter category ID" readonly="readonly" />
                <label asp-for="CategoryId">Category Id</label>
            </div>
            <div class="form-floating mb-3">
                <input type="text" class="form-control" asp-for="CategoryName" placeholder="Enter category name" />
                <label asp-for="CategoryName">Category Name</label>
                <span asp-validation-for="CategoryName" class="alert-danger"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-success fw-bold px-4">Update</button>
        <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary fw-bold">⬅️ Back to List</a>
    </form>
</div>
