@model IEnumerable<Category>
@{
    ViewData["Title"] = "Category List";
}

<div class="container mt-5 p-4 shadow-lg bg-white rounded">
    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success text-center fw-bold" role="alert">
            @TempData["SuccessMsg"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-dark">📂 Category List</h1>
        <a asp-controller="Category" asp-action="Create" class="btn btn-primary fw-bold">➕ Add Category</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover text-center align-middle">
            <thead class="table-dark text-white">
                <tr>
                    <th scope="col">Category ID</th>
                    <th scope="col">Category Name</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.CategoryId</td>
                        <td>@item.CategoryName</td>
                        <td>
                            <a asp-controller="Category" asp-action="Edit" asp-route-categoryId="@item.CategoryId" class="btn btn-success btn-sm fw-bold">✏️ Edit</a>
                            <a asp-controller="Category" asp-action="Delete" asp-route-categoryId="@item.CategoryId" class="btn btn-danger btn-sm fw-bold">🗑 Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
