@model Cart

@{
    ViewData["Title"] = "Your Cart";
}

<style>
    /* Table Styling for this page alone */
    .cart-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background-color: white;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
        overflow: hidden;
    }

    .cart-table th {
        background-color: #2C033A;
        color: white;
        padding: 12px;
        text-align: left;
    }

    .cart-table td {
        padding: 12px;
        border-bottom: 1px solid #8C98A5;
    }

    .cart-table img {
        border-radius: 5px;
        box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.2);
    }

    .cart-table tbody tr:hover {
        background-color: #f5f5f5;
    }

    /* Form Styling */
    .cart-table input[type="number"] {
        width: 50px;
        text-align: center;
        border: 1px solid #8C98A5;
        border-radius: 5px;
        padding: 5px;
    }

    /* Button Styling */
    .btn-primary {
        background-color: #2C033A;
        border: none;
        color: white;
        padding: 6px 12px;
        border-radius: 5px;
        transition: background 0.3s ease-in-out;
    }

        .btn-primary:hover {
            background-color: #520662;
        }

    .btn-danger {
        background-color: #8C98A5;
        border: none;
        color: white;
        padding: 6px 12px;
        border-radius: 5px;
        transition: background 0.3s ease-in-out;
    }

        .btn-danger:hover {
            background-color: #6D7C8A;
        }

    /* Total Price Styling */
    .cart-total {
        margin-top: 20px;
        font-size: 1.5em;
        font-weight: bold;
        color: #2C033A;
    }

    /* Links */
    .cart-links {
        margin-top: 20px;
    }

        .cart-links a {
            text-decoration: none;
            color: white;
            background-color: #2C033A;
            padding: 10px 15px;
            border-radius: 5px;
            margin-right: 10px;
            display: inline-block;
            transition: background 0.3s ease-in-out;
        }

            .cart-links a:hover {
                background-color: #520662;
            }
</style>

<table class="cart-table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Product Image</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Product.ProductName</td>
                <td><img src="@item.Product.ImageUrl" width="100px" alt="Alternate Text" /></td>
                <td>
                    <form asp-action="UpdateCartItem" method="post">
                        <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                        <input type="number" name="quantity" value="@item.Quantity" min="1" />
                        <input type="submit" value="Update" class="btn btn-primary" />
                    </form>
                </td>
                <td>R @item.Product.Price * @item.Quantity</td>
                <td>
                    <form asp-action="RemoveFromCart" method="post">
                        <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                        <input type="submit" value="Remove" class="btn btn-danger" />
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="cart-total">
    Total: R @Model.Items.Sum(i => i.Product.Price * i.Quantity)
</div>

<div class="cart-links">
    <a asp-controller="Shop" asp-action="Index">Continue Shopping</a>
    <a asp-controller="Checkout" asp-action="Index">Go To Checkout</a>
</div>
