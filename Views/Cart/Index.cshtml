@model Cart

@{
    ViewData["Title"] = "Your Cart";
}



<div class="container py-5">
    <h2 class="text-center mb-4" style="color: #2C033A;">Your Shopping Cart</h2>

    <div class="row">
        <!-- Left: Cart Items Table -->
        <div class="col-md-8">
            <table class="cart-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Image</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Product.ProductName</td>
                            <td><img src="/images/@item.Product.ImageFileName" width="50px" /></td>
                            <td>
                                <form asp-action="UpdateCartItem" method="post">
                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" />
                                    <input type="submit" value="Update" class="btn btn-primary mb-1" />
                                </form>
                            </td>
                            <td>R @(item.Product.Price * item.Quantity)</td>
                            <td>
                                <form asp-action="RemoveFromCart" method="post">
                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                    <input type="submit" value="Remove" class="btn btn-danger" />
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Right: Summary Card -->
        <div class="col-md-4">
            <div class="card shadow-lg">
                <div class="card-header text-white" style="background-color: #2C033A;">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <p class="h6">Items in Cart: <strong>@Model.Items.Count()</strong></p>
                    <p class="h6">Subtotal: <strong>R @Model.TotalPrice</strong></p>
                    <p class="h6">VAT (15%): <strong>R @((Model.TotalPrice * 0.15m).ToString("F2"))</strong></p>
                    <hr />
                    <p class="h5">Total Payable: <strong style="color: #2C033A;">R @((Model.TotalPrice * 1.15m).ToString("F2"))</strong></p>

                    <div class="form-group mt-3">
                        <label for="promoCode" class="h6">Promo Code</label>
                        <input type="text" class="form-control" id="promoCode" placeholder="Enter code" />
                        <small class="text-muted">Promo feature coming soon.</small>
                    </div>

                    <div class="mt-4">
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-custom-purple btn-block">Proceed to Checkout</a>
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-secondary btn-block mt-2">Continue Shopping</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .cart-table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        border-radius: 10px;
        overflow: hidden;
    }

        .cart-table th {
            background-color: #2C033A;
            color: white;
            padding: 12px;
        }

        .cart-table td {
            padding: 12px;
            border-bottom: 1px solid #8C98A5;
        }

        .cart-table img {
            border-radius: 5px;
            box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.2);
        }

    .btn-primary {
        background-color: #2C033A;
        border: none;
        color: white;
    }

        .btn-primary:hover {
            background-color: #520662;
        }

    .btn-danger {
        background-color: #7F7184;
        border: none;
        color: white;
    }

        .btn-danger:hover {
            background-color: #6D6072;
        }

    .btn-custom-purple {
        background-color: #7F7184;
        border: none;
        color: white;
        padding: 10px;
    }

        .btn-custom-purple:hover {
            background-color: #6D6072;
        }

    .card {
        border-radius: 10px;
    }

    .card-header h5 {
        margin-bottom: 0;
    }

    .container h2 {
        color: #2C033A;
        font-weight: bold;
    }

    input[type="number"] {
        width: 60px;
        text-align: center;
    }
</style>
