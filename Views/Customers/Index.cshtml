@model IEnumerable<SA_Online_Mart.Models.AppUser>

@{
    ViewData["Title"] = "Customer Management";
}

<section class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="fw-bold text-dark">Customer List</h1>
        <p class="text-muted">View and manage registered customers</p>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="container">
            <div class="row align-items-center justify-content-center g-2">
                <div class="col-md-8">
                    <input type="text" class="form-control form-control-lg"
                           name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           placeholder="Search by email..."
                           style="border: 2px solid #2C033A; border-radius: 8px;" />
                </div>
                <div class="col-md-2 d-grid">
                    <input type="submit" value="Search" class="btn btn-custom-purple btn-lg" />
                </div>
                <div class="col-md-2 d-grid">
                    <a asp-action="Index" class="btn btn-secondary btn-lg">Back to Full List</a>
                </div>
            </div>
        </div>
    </form>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-lg border-0 rounded p-4" style="background-color: #F8F9FA;">
                    <h3 class="fw-bold text-primary">👤 Customer</h3>
                    <hr>
                    <p class="fw-bold text-dark">Full Name: <span class="fw-normal">@item.FirstName @item.LastName</span></p>
                    <p class="fw-bold text-dark">Email: <span class="fw-normal">@item.Email</span></p>
                    <p class="fw-bold text-dark">Phone: <span class="fw-normal">@item.PhoneNumber</span></p>
                    <div class="d-flex justify-content-end mt-3">
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this customer?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                🗑️ Delete
                            </button>
                        </form>
                    </div>
                </div>
                
            </div>
        }
    </div>
</section>

<style>
    .btn-custom-purple {
        background-color: #2C033A;
        color: white;
        border: none;
    }

        .btn-custom-purple:hover {
            background-color: #8C98A5;
            color: #fff;
        }

    .form-control:focus {
        box-shadow: 0 0 5px rgba(44, 3, 58, 0.5);
        border-color: #2C033A;
    }
</style>
