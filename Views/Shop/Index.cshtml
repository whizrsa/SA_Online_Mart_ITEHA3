@model IEnumerable<Product>

@{
    ViewData["Title"] = "Shop Page";
}

<div class="main-page py-4" style="background-color: #f5f5f5;">
    <form asp-action="Index" method="get" class="mb-4">
        <div class="container">
            <div class="row align-items-center justify-content-center g-2">
                <div class="col-md-8">
                    <input type="text" class="form-control form-control-lg"
                           name="searchString"
                           value="@ViewData["CurrentFilter"]"
                           placeholder="Search by product or category..."
                           style="border: 2px solid #2C033A; border-radius: 8px;" />
                </div>
                <div class="col-md-2 d-grid">
                    <input type="submit" value="Search" class="btn btn-custom-purple btn-lg" />
                </div>
                <div class="col-md-2 d-grid">
                    <a asp-action="Index" class="btn btn-secondary btn-lg">Back to Full List</a>
                </div>
            </div>
        </div>
    </form>

    <!-- Product List -->
    <div class="album">
        <div class="container">
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-4">
                        <div class="card shadow-lg border-0 rounded" style="background-color: #2C033A; color: #fff;">
                            <img class="card-img-top p-3" src="/images/@item.ImageFileName" alt="Product Image"
                                 style="height: 250px; object-fit: cover; border-radius: 10px;">

                            <div class="card-body text-center">
                                <h5 class="card-title">@item.ProductName</h5>
                                <p class="card-text">Price: <strong>R @item.Price</strong></p>

                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <a asp-controller="Home" asp-action="Detail" asp-route-id="@item.ProductId"
                                       class="btn text-white" style="background-color: #8C98A5;">View</a>

                                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-outline-light">Add to Cart</button>
                                    </form>
                                </div>
                            </div>

                            <div class="card-footer bg-transparent border-0 text-center">
                                <span class="badge" style="background-color: #8C98A5;">
                                    @(item.Category != null ? item.Category.CategoryName : "No Category")
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Custom Button Styling -->
<style>
    .btn-custom-purple {
        background-color: #2C033A;
        color: white;
        border: none;
    }

        .btn-custom-purple:hover {
            background-color: #8C98A5;
            color: #fff;
        }

    .form-control:focus {
        box-shadow: 0 0 5px rgba(44, 3, 58, 0.5);
        border-color: #2C033A;
    }

    .badge {
        font-size: 0.9rem;
        padding: 0.4em 0.8em;
        border-radius: 1rem;
    }
</style>
