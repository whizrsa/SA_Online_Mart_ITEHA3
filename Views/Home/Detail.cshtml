@model SA_Online_Mart.Models.Product

@{
    ViewData["Title"] = "Detail Page";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded p-4" style="max-width: 800px; background-color: #ffffff; margin: auto;">
        <div class="row g-4 align-items-center">
            <!-- Product Image -->
            <div class="col-md-5">
                <img src="@Model.ImageUrl" alt="@Model.ProductName" class="img-fluid rounded shadow-sm" style="width: 100%; height: auto;">
            </div>

            <!-- Product Details -->
            <div class="col-md-7">
                <div class="product-info">
                    <h2 class="text-dark fw-bold">@Model.ProductName</h2>
                    <p class="fs-5 text-muted">Category: <span class="fw-semibold">@Model.Category.CategoryName</span></p>
                    <p class="fs-4 fw-bold text-success">R @Model.Price</p>
                    <p class="text-secondary">@Model.Description</p>

                    <!-- Add to Cart Form -->
                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn text-white fw-bold" style="background-color: #2C033A;">🛒 Add to Cart</button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">🏠 Return to Home</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
