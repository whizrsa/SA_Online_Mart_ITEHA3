@model IEnumerable<Product>

@{
    ViewData["Title"] = "Home Page";
}

<div class="main-page">
    <!-- Slider main container -->
    <div class="swiper">
        <!-- Additional required wrapper -->
        <div class="swiper-wrapper">
            <!-- Slides -->
            <div class="swiper-slide">
                <div class="image">
                    <img src="images/img4.jpg" alt="Image 1">
                </div>
                <div class="content">
                    <span>Jewelry 20% off</span>
                    <h3>Hot Specials</h3>
                    <a href="shop.php" class="btnH">shop now</a>
                </div>
            </div>
            <div class="swiper-slide">
                <div class="image">
                    <img src="images/img2.jpg" alt="Image 2">
                </div>
                <div class="content">
                    <span>Jewelry 20% off</span>
                    <h3>Hot Specials</h3>
                    <a href="shop.php" class="btnH">shop now</a>
                </div>
            </div>
            <div class="swiper-slide">
                <div class="image">
                    <img src="images/img3.jpg" alt="Image 3">
                </div>
                <div class="content">
                    <span>Jewelry 20% off</span>
                    <h3>Hot Specials</h3>
                    <a class="btnH" asp-controller="Shop" asp-action="Index">shop now</a>
                </div>
            </div>
            <!-- Add more slides as needed -->
        </div>

        <!-- If we need pagination -->
        <div class="swiper-pagination"></div>


        <!-- If we need navigation buttons
            <div class="swiper-button-prev text-light"></div>
            <div class="swiper-button-next text-light"></div>
         -->
        <!-- If we need scrollbar -->
        <div class="swiper-scrollbar"></div>
    </div>

    <!-- Home Category Section Starts -->
    <h2 class="heading text-center my-4 text-dark">Latest Products</h2>

    <div class="album py-5">
        <div class="container">
            <div class="row g-4">
                <!-- Bootstrap gutter spacing for rows -->
                @foreach (var item in Model)
                {
                    <div class="col-md-4">
                        <div class="card shadow-lg border-0 rounded" style="background-color: #2C033A; color: #fff;">
                            <img class="card-img-top p-3" src="@item.ImageUrl" alt="Product Image"
                                 style="height: 250px; object-fit: cover; border-radius: 10px;">

                            <div class="card-body text-center">
                                <h5 class="card-title">@item.ProductName</h5>
                                <p class="card-text">Price: <strong>R @item.Price</strong></p>

                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <a asp-controller="Home" asp-action="Detail" asp-route-id="@item.ProductId"
                                       class="btn text-white" style="background-color: #8C98A5;">View</a>

                                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-outline-light">Add to Cart</button>
                                    </form>
                                </div>
                            </div>

                            <div class="card-footer bg-transparent border-0 text-center">
                                <span class="badge" style="background-color: #8C98A5;">@item.Category.CategoryName</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>


</div>
