@using SA_Online_Mart.ViewModel
@model IEnumerable<Product>

@{
    ViewData["Title"] = "Product List";
}

<div class="container mt-5 p-4 shadow-lg bg-white rounded">
    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success text-center fw-bold" role="alert">
            @TempData["SuccessMsg"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-dark">📦 Product List</h1>
        <a asp-controller="Product" asp-action="Create" class="btn btn-primary fw-bold">➕ Add Product</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover text-center align-middle">
            <thead class="table-dark text-white">
                <tr>
                    <th scope="col">Product Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Price</th>
                    <th scope="col">Category</th>
                    <th scope="col">Image</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.ProductName</td>
                        <td>@item.Description</td>
                        <td class="text-success fw-bold">R @item.Price</td>
                        <td>@item.Category.CategoryName</td>
                        <td>
                            <img src="/images/@item.ImageFileName" class="img-thumbnail rounded shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" />
                        </td>
                        <td>
                            <a asp-controller="Product" asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-success btn-sm fw-bold">✏️ Edit</a>
                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.ProductId" />
                                <button type="submit" class="btn btn-danger btn-sm fw-bold" onclick="return confirm('Are you sure you want to delete this product?');">
                                    🗑 Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
